<h2 class="h4 mb-3">Search results for "<%= @query %>"</h2>

<% if @results.empty? %>
  <div class="alert alert-secondary">No results.</div>
<% else %>
  <div class="list-group shadow-sm">
    <% @results.each do |t| %>
      <%= link_to stock_path(t["symbol"]), class: "list-group-item list-group-item-action d-flex justify-content-between" do %>
        <span><strong><%= t["symbol"] %></strong> &ndash; <%= t["name"] %></span>
        <span class="text-muted small"><%= t.dig("stock_exchange", "acronym") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>