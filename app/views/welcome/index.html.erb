<%# app/views/welcome/index.html.erb %>
<% if user_signed_in? %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0">Dashboard</h1>
      <p class="text-muted mb-0">Welcome back, <%= current_user.email %></p>
    </div>
    <%= link_to user_stocks_path, class: "btn btn-outline-dark btn-sm" do %>
      <i class="bi bi-briefcase"></i> View full portfolio
    <% end %>
  </div>

  <% if @user_stocks.empty? %>
    <div class="card shadow-sm text-center py-5">
      <div class="card-body">
        <i class="bi bi-graph-up-arrow display-4 text-success"></i>
        <h2 class="h5 mt-3">Your portfolio is empty</h2>
        <p class="text-muted">Use the search bar above to find a stock symbol (e.g. AAPL, MSFT) and add it.</p>
      </div>
    </div>
  <% else %>
    <div class="row g-3">
      <% @user_stocks.each do |us| %>
        <% stock = us.stock %>
        <div class="col-12 col-md-6 col-lg-4">
          <%= link_to stock_path(stock.symbol), class: "text-decoration-none" do %>
            <div class="card shadow-sm h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between">
                  <h2 class="h5 text-dark mb-0"><%= stock.symbol %></h2>
                  <span class="text-muted small"><%= stock.exchange %></span>
                </div>
                <div class="text-muted small text-truncate"><%= stock.name %></div>
                <div class="display-6 text-dark mt-2">
                  $<%= number_with_precision(stock.last_price, precision: 2) %>
                </div>
                <div class="text-muted small">Close on <%= stock.last_price_date %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

<% else %>
  <div class="text-center py-5">
    <i class="bi bi-graph-up-arrow display-3 text-success"></i>
    <h1 class="display-5 fw-bold mt-3">Track your stocks in one place</h1>
    <p class="lead text-muted">Search symbols, view end-of-day prices, and build your own portfolio.</p>
    <div class="mt-4">
      <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-success btn-lg me-2" %>
      <%= link_to "Sign In", new_user_session_path, class: "btn btn-outline-dark btn-lg" %>
    </div>
  </div>
<% end %>